#!/usr/bin/env bash
set -euo pipefail

# Использование:
#   ./k8s_snapshot.sh kubeconfig.yaml > snapshot.json
#   ./k8s_snapshot.sh kubeconfig.yaml --minify > snapshot.min.json

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <kubeconfig.yaml> [--minify]"
  exit 1
fi

KUBECONFIG_FILE="$1"
export KUBECONFIG="$KUBECONFIG_FILE"
MINIFY=false
[[ $# -gt 1 && "$2" == "--minify" ]] && MINIFY=true

TMPDIR="$(mktemp -d)"
cleanup() { rm -rf "$TMPDIR"; }
trap cleanup EXIT

# --- Сбор ---
kubectl config current-context > "$TMPDIR/context.txt" 2>&1 || true
kubectl get --raw='/readyz?verbose' > "$TMPDIR/readyz.txt" 2>&1 || true
kubectl get --raw='/livez?verbose'  > "$TMPDIR/livez.txt"  2>&1 || true
kubectl version -o json            > "$TMPDIR/version.json" 2>/dev/null || echo '{}' > "$TMPDIR/version.json"

kubectl get nodes        -o json > "$TMPDIR/nodes.json"        2>/dev/null || echo '{}' > "$TMPDIR/nodes.json"
kubectl get ns           -o json > "$TMPDIR/namespaces.json"   2>/dev/null || echo '{}' > "$TMPDIR/namespaces.json"
kubectl get pods     -A -o json > "$TMPDIR/pods.json"          2>/dev/null || echo '{}' > "$TMPDIR/pods.json"
kubectl get deploy  -A -o json > "$TMPDIR/deployments.json"    2>/dev/null || echo '{}' > "$TMPDIR/deployments.json"

# describe namespaces (оставляем только в full)
NS_LIST=$(kubectl get ns -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)
DESC_FILE="$TMPDIR/namespaces_describe.txt"
: > "$DESC_FILE"
if [[ -n "${NS_LIST}" ]]; then
  while IFS= read -r ns; do
    echo -e "===== NAMESPACE: ${ns} =====" >> "$DESC_FILE"
    kubectl describe ns "$ns" >> "$DESC_FILE" 2>&1 || true
    echo >> "$DESC_FILE"
  done <<< "$NS_LIST"
else
  echo "no namespaces listed or access denied" > "$DESC_FILE"
fi

# --- Вывод ---
if ! $MINIFY; then
  jq -c -n \
    --rawfile context        "$TMPDIR/context.txt" \
    --rawfile readyz         "$TMPDIR/readyz.txt" \
    --rawfile livez          "$TMPDIR/livez.txt" \
    --slurpfile version      "$TMPDIR/version.json" \
    --slurpfile nodes        "$TMPDIR/nodes.json" \
    --slurpfile namespaces   "$TMPDIR/namespaces.json" \
    --rawfile ns_describe    "$DESC_FILE" \
    --slurpfile pods         "$TMPDIR/pods.json" \
    --slurpfile deployments  "$TMPDIR/deployments.json" '
  {
    collected_at: (now | todate),
    kubeconfig:   "'"$KUBECONFIG_FILE"'",
    context:      $context,
    health:       { readyz: $readyz, livez: $livez },
    version:      ($version | if length>0 then .[0] else {} end),
    nodes:        ($nodes   | if length>0 then .[0] else {} end),
    namespaces:   { list: ($namespaces|if length>0 then .[0] else {} end), describe: $ns_describe },
    pods:         ($pods        | if length>0 then .[0] else {} end),
    deployments:  ($deployments | if length>0 then .[0] else {} end)
  }'
else
  jq -c '
  def sumrestarts:
    ( [ .status.containerStatuses // [], .status.initContainerStatuses // [] ] | add )
    | map( .restartCount // 0 ) | add;

  def reasons:
    ( [ .status.containerStatuses // [], .status.initContainerStatuses // [] ] | add )
    | map(
        ( .state.waiting.reason // empty ),
        ( .lastState.terminated.reason // empty ),
        ( .state.terminated.reason // empty )
      )
    | map(select(. != null and . != "")) | unique;

  def pod_problem:
    .status.phase as $ph
    | ( ($ph != "Running" and $ph != "Succeeded")
        or (([ .status.containerStatuses // [], .status.initContainerStatuses // [] ] | add
             | any( ( .state.waiting.reason // null ),
                    ( .lastState.terminated.reason // null ),
                    ( .state.terminated.reason // null ) ; . != null )) )
    );

  def node_not_ready:
    ( .status.conditions // [] )
    | ( any( .[]; (.type=="Ready" and .status!="True") ) or
        any( .[]; ((.type=="MemoryPressure" or .type=="DiskPressure" or .type=="PIDPressure" or .type=="NetworkUnavailable") and .status=="True") ) );

  def conds_brief:
    ( .status.conditions // [] )
    | map({type, status, reason, message})
    | map(select( ( ( .type=="Ready"      and .status!="True") ) or
                  ( ( .type=="MemoryPressure" or .type=="DiskPressure" or .type=="PIDPressure" or .type=="NetworkUnavailable") and .status=="True") ))
    ;

  def deploy_not_ready:
    ((.spec.replicas // 0) != (.status.availableReplicas // 0));

  def readyz_fail_count(s): (s // "") | split("\n") | map(select(startswith("[-]"))) | length;

  {
    collected_at,
    kubeconfig: "'"$KUBECONFIG_FILE"'",
    health: (
      . as $root
      | { readyz_failed_checks: readyz_fail_count($root.health.readyz),
          livez_failed_checks:  readyz_fail_count($root.health.livez) }
    ),
    version: { server: (.version.serverVersion // {}), client: (.version.clientVersion // {}) },
    nodes: (
      .nodes.items as $nodes |
      { total: ($nodes|length),
        not_ready: ($nodes | map(select(node_not_ready)) | length),
        problems: ($nodes | map(select(node_not_ready)
                   | { name: .metadata.name,
                       roles: (.metadata.labels["kubernetes.io/role"] // .metadata.labels["node-role.kubernetes.io/control-plane"] // null),
                       conditions: conds_brief } ) ) }
    ),
    namespaces: (
      (.namespaces.items // []) as $ns |
      { total: ($ns|length),
        non_active: ($ns | map(select(.status.phase != "Active")) | map({name: .metadata.name, phase: .status.phase})) }
    ),
    deployments: (
      (.deployments.items // []) as $d |
      { total: ($d|length),
        not_ready: ($d | map(select(deploy_not_ready)) | length),
        problems: ($d | map(select(deploy_not_ready)
                   | { ns: .metadata.namespace, name: .metadata.name,
                       desired: (.spec.replicas // 0),
                       available: (.status.availableReplicas // 0),
                       updated: (.status.updatedReplicas // 0),
                       ready: (.status.readyReplicas // 0) })) }
    ),
    pods: (
      (.pods.items // []) as $p |
      { total: ($p|length),
        problematic: ($p | map(select(pod_problem)) | length),
        problems: ($p | map(select(pod_problem)
                   | { ns: .metadata.namespace,
                       name: .metadata.name,
                       phase: .status.phase,
                       node: (.spec.nodeName // null),
                       reasons: reasons,
                       restarts: sumrestarts }) ) }
    )
  }' \
    --slurpfile version      "$TMPDIR/version.json" \
    --slurpfile nodes        "$TMPDIR/nodes.json" \
    --slurpfile namespaces   "$TMPDIR/namespaces.json" \
    --slurpfile pods         "$TMPDIR/pods.json" \
    --slurpfile deployments  "$TMPDIR/deployments.json" \
    --rawfile readyz         "$TMPDIR/readyz.txt" \
    --rawfile livez          "$TMPDIR/livez.txt" \
    --arg collected_at "$(date -u +%FT%TZ)"
fi
